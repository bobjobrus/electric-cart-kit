+    // N_MOT_MAX: потолок последней поездки контроллер держал бы, урезая напряжение, то есть подтормаживал бы
+    rtP_Left.b_cruiseCtrlEna  = 0;
+    rtP_Right.b_cruiseCtrlEna = 0;
+    rtP_Left.n_max  = (int16_t)(N_MOT_MAX << 4);
+    rtP_Right.n_max = rtP_Left.n_max;
+    if (fade && trq16 > 0 && !ov) {        // «сдалась» на крутом подъёме: тягу снимаем плавно, груз не бросаем
+                                           // (тележка при этом откатывается — тяга тормозит; перенапряжение — сразу 0)
+      trq16 = STEP(trq16, 0, (int32_t)16000 * DELAY_IN_MAIN_LOOP / CART_GIVEUP_FADE_MS);
+    } else {
+      trq16 = 0;
+      fade  = 0;
+    }
+    hold16 = fadeSgn * trq16;              // нажали снова, пока тяга уходит, — регулятор начнёт с неё, без провала
+    input2[inIdx].cmd = (int16_t)(fadeSgn * trq16 / 16);
+  } else if (drive == CART_REL) {
+    if (!enable || ov) {                   // моторы выключены / перенапряжение — цель просто следует за колесом
+      holdL256 = (int32_t)nL * 256;
+      holdR256 = (int32_t)nR * 256;
+    }
+    rtP_Left.b_cruiseCtrlEna  = !ov;       // перенапряжение: без удержания (оно тормозит), момент 0 — катится
+    rtP_Right.b_cruiseCtrlEna = !ov;
+    rtP_Left.n_max  = (int16_t)(N_MOT_MAX << 4);   // в удержании потолок не нужен; не оставлять 1000 после перенапряжения
+    rtP_Right.n_max = rtP_Left.n_max;
+    holdL256 = STEP(holdL256, 0, CART_STEP256(CART_STOP_KMH10_S));
+    holdR256 = STEP(holdR256, 0, CART_STEP256(CART_STOP_KMH10_S));
+    rtP_Left.n_cruiseMotTgt  = (int16_t)(holdL256 / 256);
+    rtP_Right.n_cruiseMotTgt = (int16_t)(holdR256 / 256);
+
+    // Каким моментом колёса сейчас держат тележку (измеренный iq → ‰ от i_max ×16), сглаживаем
+    int32_t eqL =  (int32_t)rtY_Left.iq  * 16000 / rtP_Left.i_max;    // левый мотор: pwml = +cmd
+    int32_t eqR = -(int32_t)rtY_Right.iq * 16000 / rtP_Right.i_max;   // правый мотор: pwmr = -cmd
+    #ifdef INVERT_L_DIRECTION
+      eqL = -eqL;
+    #endif
+    #ifdef INVERT_R_DIRECTION
+      eqR = -eqR;
+    #endif
+    hold16 += ((eqL + eqR) / 2 - hold16) / 8;
+
+    trq16 = 0;
+    input2[inIdx].cmd = 0;                 // в режиме удержания момент не используется
+  } else {
+    // Всё ниже — «по ходу движения»: для заднего хода знак переворачиваем только на выходе
+    int32_t sgn   = (drive == CART_FWD) ? 1 : -1;
+    int32_t hiLim = (int32_t)((drive == CART_FWD) ? CART_TRQ_FWD : CART_TRQ_REV) << 4;   // тянуть
+    int32_t loLim = -((int32_t)CART_TRQ_BRK << 4);                                        // тормозить
+    if (ov) {                              // перенапряжение: не тормозить; тележку катит назад — и не тянуть (это тоже торможение)
+      loLim = 0;
+      if (sgn * (int32_t)speedAvg < -CART_STALL_RPM) { hiLim = 0; }
+    }
+
+    // Спуск: моторы тормозят дольше CART_DOWN_MS — потолок 4 км/ч, пока снова не потянут дольше CART_DOWN_OFF_MS
+    if (trq16 < -(30 << 4))      { upCnt = 0; if (downCnt < 60000) { downCnt++; } }
+    else if (trq16 > (30 << 4))  { downCnt = 0; if (upCnt < 60000) { upCnt++; } }
+    if (downCnt >= CART_LOOPS(CART_DOWN_MS))    { downCap = 1; }
+    if (upCnt   >= CART_LOOPS(CART_DOWN_OFF_MS)) { downCap = 0; }
+
+    // Заданная скорость: колёсико (вперёд) или постоянная (назад); к ней — плавно (разгон и сброс)
+    int32_t kmh10 = (drive == CART_FWD)
+                  ? CART_SPEED_MIN_KMH10 + knob * (CART_SPEED_MAX_KMH10 - CART_SPEED_MIN_KMH10) / 1000
+                  : CART_SPEED_REV_KMH10;
+    if (downCap)                { kmh10 = MIN(kmh10, CART_SPEED_DOWN_KMH10); }
+    if (batVoltage < BAT_LVL1)  { kmh10 = MIN(kmh10, CART_SPEED_LOWBAT_KMH10); }   // садится батарея
+    int32_t tgt256 = MIN(CART_RPM256(kmh10), (int32_t)N_MOT_MAX << 8);
+    vref256 = STEP(vref256, tgt256, (tgt256 > vref256) ? CART_STEP256(CART_ACCEL_KMH10_S) : CART_STEP256(CART_STOP_KMH10_S));
+
+    // ПИ-регулятор средней скорости → момент (одинаковый на оба колеса)
+    int32_t err256 = vref256 - sgn * (int32_t)speedAvg * 256;
+    integ12 += (int32_t)CART_KI * err256 * DELAY_IN_MAIN_LOOP * 16 / 1000;
+    integ12  = CLAMP(integ12, loLim * 256, hiLim * 256);                   // без «накопления» сверх пределов
+    int32_t u16 = CLAMP((int32_t)CART_KP * err256 / 16 + integ12 / 256, loLim, hiLim);
+    trq16 = STEP(trq16, u16, (int32_t)16000 * DELAY_IN_MAIN_LOOP / CART_TRQ_SLEW_MS);   // без рывков
+    trq16 = CLAMP(trq16, loLim, hiLim);    // перенапряжение — сразу, без плавности (иначе тормоз уходил бы до 0,35 с)
+
+    // «Упёрлась — сдалась»: тянем на пределе, а тележка стоит дольше CART_STALL_MS — тягу снять (при накате — плавно),
+    // 1 гудок; при CART_COAST 0 — удержание
+    if (trq16 >= hiLim * 9 / 10 && ABS(speedAvg) < CART_STALL_RPM) {
+      if (++stallCnt >= CART_LOOPS(CART_STALL_MS)) { armed = 0; fade = CART_COAST; stallCnt = 0; cartBeep(1, 24, 1, 1500); }
+    } else {
+      stallCnt = 0;
+    }
+
+    // Быстрее заданной на CART_OVER_KMH10 — частый писк «держи»
+    if (sgn * (int32_t)speedAvg * 256 > tgt256 + CART_RPM256(CART_OVER_KMH10)) { cartBeep(0, 5, 1, 300); }
+
+    // Запасной потолок каждого колеса (встроенная защита): заданная ×1,25 + ~0,5 км/ч, не выше N_MOT_MAX.
+    // Берём большую из «текущей заданной» и «конечной», чтобы при сбросе колёсика потолок не тормозил резче регулятора.
+    int32_t ref256  = MAX(vref256, tgt256);
+    int32_t ceil256 = MIN(ref256 + ref256 / 4 + CART_RPM256(5), (int32_t)N_MOT_MAX << 8);
+    rtP_Left.n_max  = (int16_t)(ceil256 >> 4);                              // об/мин ×16
+    rtP_Right.n_max = rtP_Left.n_max;
+
+    input2[inIdx].cmd = (int16_t)(sgn * trq16 / 16);
+  }
+
+  if (ov) {                                // перенапряжение: потолки колёс сняты — у потолка контроллер тормозил бы
+    rtP_Left.n_max  = (int16_t)(CART_OV_NMAX << 4);
+    rtP_Right.n_max = rtP_Left.n_max;
+  }
+}
+#endif
