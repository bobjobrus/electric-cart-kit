+    cartDiagTestRequest = 0;
+    if (request == 0x43543031 && !cartDiagTestLeftMs) {
+      testLevel = MIN(MAX(cartDiagTestLevel, 40), 200);
+      started = HAL_GetTick();
+      cartDiagTestLeftMs = 30000;
+    } else if (request) {
+      cartDiagTestLeftMs = 0;             // любой другой ненулевой ключ — отмена
+    }
+    if (cartDiagTestLeftMs) {
+      uint32_t elapsed = HAL_GetTick() - started;
+      cartDiagTestLeftMs = elapsed < 30000 ? 30000 - elapsed : 0;
+      if (!enable || cartBtnPressed || ov || rtY_Left.z_errCode || rtY_Right.z_errCode || timeoutFlgGen) {
+        cartDiagTestLeftMs = 0;           // сбой/кнопка — отмена, не автоматический повтор
+      }
+    }
+    int32_t tgt16 = cartDiagTestLeftMs > 1000 ? testLevel * 16 : 0;  // последняя секунда — плавный спад
+    if (!cartDiagTestLeftMs) v16 = 0;
+    else v16 = STEP(v16, tgt16, (testLevel * 16 * DELAY_IN_MAIN_LOOP + 999) / 1000);
+    cartLeverHeld = cartDiagTestLeftMs != 0;
+    #else
+    int32_t tgt16 = (armed && enable && handle == CART_FWD)
+                  ? ((int32_t)CART_DIAG_VLT_MIN + knob * (CART_DIAG_VLT_MAX - CART_DIAG_VLT_MIN) / 1000) << 4
+                  : 0;
+    v16 = STEP(v16, tgt16, (int32_t)16000 * DELAY_IN_MAIN_LOOP / CART_DIAG_RAMP_MS);
+    #endif
+    rtP_Left.b_cruiseCtrlEna  = 0;
+    rtP_Right.b_cruiseCtrlEna = 0;
+    input2[inIdx].cmd = (int16_t)(v16 / 16);
+    return;
+  }
+  #elif defined(CART_SIN_DRIVE)
+  {
+    static int32_t v16 = 0;              // команда напряжения, ‰ ×16
+    static int32_t trim256 = 0;          // медленная добавка при езде под нагрузкой, ‰ ×256
+    static uint8_t speedCut = 0;
+    static uint16_t stoppedLoops = 0;
+
+    if (now == CART_FAULT || ov || rtY_Left.z_errCode || rtY_Right.z_errCode) {
+      armed = 0;                        // повторный пуск только после отпускания
+    }
+
+    if (!armed || handle != CART_FWD || now != CART_FWD) {
+      v16 = 0;
+      trim256 = 0;
+      stoppedLoops = 0;
+    } else {
+      int32_t kmh10 = CART_SPEED_MIN_KMH10 + knob * (CART_SPEED_MAX_KMH10 - CART_SPEED_MIN_KMH10) / 1000;
+      int32_t maxKmh10 = CART_SPEED_MAX_KMH10;
+      if (batVoltage < BAT_LVL1) {
+        maxKmh10 = MIN(maxKmh10, CART_SPEED_LOWBAT_KMH10);
+      }
+      kmh10 = MIN(kmh10, maxKmh10);
+
+      int32_t targetRpm = (CART_RPM256(kmh10) + 128) >> 8;
+      int32_t speedLimit = MIN(targetRpm + CART_SIN_SPEED_BAND_RPM, CART_RPM256(maxKmh10) >> 8);
+      int32_t wheelLimit = MIN(targetRpm * 5 / 4 + (CART_RPM256(5) >> 8), N_MOT_MAX);
+      int32_t speed = ABS(speedAvg);
+      int32_t fasterWheel = MAX(ABS(rtY_Left.n_mot), ABS(rtY_Right.n_mot));
+      int32_t margin = speedCut ? CART_SIN_SPEED_BAND_RPM : 0;
+      speedCut = speed >= speedLimit - margin || fasterWheel >= wheelLimit - margin;
+
+      if (speed > ((CART_RPM256(kmh10 + CART_OVER_KMH10)) >> 8)) {
+        cartBeep(0, 5, 1, 300);
+      }
+
+      if (speedCut) {
+        v16 = 0;                        // силовые выходы отключаются в bldc.c
+        trim256 = 0;
+        stoppedLoops = 0;
+      } else {
+        // Холостой ход YK99: около 48‰ дают 21 об/мин, 120‰ дают около 69 об/мин.
+        // При отставании больше 4 об/мин добавляем напряжение медленно; вблизи задания добавка уходит.
+        int32_t base = (19 + 14 * targetRpm / 10) * CART_OV_ADC(4050) /
+                       MAX(batVoltageFast, CART_OV_ADC(3600));
+        base = MIN(base, CART_SIN_MAX_VLT);
+        int32_t error = targetRpm - speed - CART_SIN_SPEED_BAND_RPM;
+        int32_t target16 = base * 16 + trim256 / 16;
+        v16 = STEP(v16, target16, CART_SIN_RAMP * 16 * DELAY_IN_MAIN_LOOP / 1000);
+        if (v16 >= base * 16 || error < 0) {
+          trim256 = CLAMP(trim256 + error * 256 * DELAY_IN_MAIN_LOOP / 1000,
+                          0, (CART_SIN_MAX_VLT - base) * 256);
+        }
+
+        if (fasterWheel >= CART_STALL_RPM) {
+          stoppedLoops = 0;
+        } else if (++stoppedLoops >= CART_LOOPS(CART_STALL_MS)) {
+          armed = 0;
+          v16 = 0;
+          cartBeep(1, 24, 1, 1500);
+        }
+      }
+    }
+    input2[inIdx].cmd = (int16_t)(v16 / 16);
+    return;
+  }
+  #endif
+
+  // ---- 2. Чего хочет человек ----
+  int16_t nL  = rtY_Left.n_mot;
+  int16_t nR  = rtY_Right.n_mot;
+  uint8_t want = (armed && enable && (handle == CART_FWD || (handle == CART_REV && revOk))) ? handle : CART_REL;
+  if (!CART_COAST && want == CART_FWD && speedAvg < -CART_DIRCHG_RPM) { want = CART_REL; }  // катимся назад — сначала остановка
+  if (want == CART_REV && speedAvg >  CART_DIRCHG_RPM) { want = CART_REL; }  // катимся вперёд — сначала остановка
+
+  // ---- 3. Переходы ----
+  if (want != drive || first) {
+    if (want == CART_REL) {
+      // Остановка: цель удержания = текущая скорость каждого колеса, дальше плавно сводим к 0
+      holdL256 = (int32_t)nL * 256;
+      holdR256 = (int32_t)nR * 256;
+      fadeSgn  = (drive == CART_REV) ? -1 : 1;
+      hold16   = CART_COAST ? 0 : fadeSgn * trq16;   // в знаках команды (вперёд = +)
+      rtP_Left.b_cruiseCtrlEna  = !CART_COAST && !ov;  // накат: режим момента с нулём; иначе — удержание скоростью 0
+      rtP_Right.b_cruiseCtrlEna = !CART_COAST && !ov;  // (перенапряжение: без удержания — оно тормозит)
+    } else {
+      // Трогание: регулятор начинает с того момента, которым колёса держали тележку (на подъёме не откатится),
+      // а заданная скорость — с текущей (разгон дальше плавный)
+      int32_t sgn   = (want == CART_FWD) ? 1 : -1;
+      int32_t hiLim = (int32_t)((want == CART_FWD) ? CART_TRQ_FWD : CART_TRQ_REV) << 4;
+      trq16   = CLAMP(sgn * hold16, -((int32_t)CART_TRQ_BRK << 4), hiLim);
+      integ12 = trq16 * 256;
+      vref256 = MAX(sgn * (int32_t)speedAvg, 0) << 8;
+      fade    = 0;
+      rtP_Left.b_cruiseCtrlEna  = 0;
+      rtP_Right.b_cruiseCtrlEna = 0;
+    }
+    drive    = want;
+    first    = 0;
+    stallCnt = 0;
+  }
+
+  // ---- 4. Каждый цикл ----
+  if (drive == CART_REL && CART_COAST) {
